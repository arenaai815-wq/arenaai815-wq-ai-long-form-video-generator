# ==============================================================================
# LongForm AI — environment configuration
# Copy to `.env` at the repo root (read by the API, workers and docker-compose).
# Never commit `.env`. Only values in frontend/.env.example are ever visible to
# browsers — everything in this file stays server-side.
# ==============================================================================

# --- App ----------------------------------------------------------------------
APP_NAME="LongForm AI"
ENVIRONMENT=development            # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (only needed when the frontend
# is NOT proxying /api to the backend on the same origin).
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^https://.*\.yourdomain\.com$

# --- Security -----------------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_GENERATION=30/minute

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://longform:longform@localhost:5432/longform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis / job queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1      # defaults to REDIS_URL
# CELERY_RESULT_BACKEND=redis://localhost:6379/2  # defaults to REDIS_URL
JOB_DEFAULT_TIMEOUT_SECONDS=1800
RENDER_JOB_TIMEOUT_SECONDS=7200
JOB_MAX_RETRIES=3
WORKER_HEARTBEAT_TTL_SECONDS=60

# --- Object storage -----------------------------------------------------------
# local  -> files under STORAGE_LOCAL_PATH, served through signed /media/files URLs
# s3     -> any S3-compatible bucket (AWS S3, MinIO, Cloudflare R2, Backblaze B2...)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=longform-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_USE_PATH_STYLE=true
# STORAGE_PUBLIC_BASE_URL=https://cdn.yourdomain.com   # optional CDN in front of the bucket
SIGNED_URL_EXPIRE_SECONDS=3600

# --- AI providers -------------------------------------------------------------
# Every capability is resolved through the provider registry. `mock` adapters run the
# entire pipeline offline (deterministic text, generated images, synthesized speech),
# so the platform works with zero keys. Switch a provider by name and add its key.
LLM_PROVIDER=mock        # mock | openai | anthropic | openai_compatible
IMAGE_PROVIDER=mock      # mock | openai | stability | replicate
VIDEO_PROVIDER=mock      # mock | replicate | runway
TTS_PROVIDER=mock        # mock | openai | elevenlabs
STT_PROVIDER=mock        # mock | openai_whisper | deepgram
STOCK_PROVIDER=mock      # mock | pexels

# OPENAI_API_KEY=
# OPENAI_BASE_URL=                       # for openai_compatible gateways (Groq, Together, Ollama...)
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# STABILITY_API_KEY=
# REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=minimax/video-01
# RUNWAY_API_KEY=
# LUMA_API_KEY=
# DEEPGRAM_API_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=3

# --- Rendering (FFmpeg) -------------------------------------------------------
# FFMPEG_BINARY=/usr/bin/ffmpeg        # auto-detected (PATH, then imageio-ffmpeg) when unset
# FFPROBE_BINARY=/usr/bin/ffprobe
RENDER_THREADS=0                       # 0 = let ffmpeg decide
RENDER_PRESET=medium                   # ultrafast ... veryslow
RENDER_CRF=20
RENDER_WORK_DIR=./data/work
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
WATERMARK_TEXT="Made with LongForm AI"
MAX_VIDEO_DURATION_MINUTES=120

# --- Billing / credits --------------------------------------------------------
FREE_PLAN_CREDITS=500
CREDIT_COST_RESEARCH=5
CREDIT_COST_SCRIPT_PER_MINUTE=2
CREDIT_COST_TTS_PER_1K_CHARS=3
CREDIT_COST_IMAGE=4
CREDIT_COST_VIDEO_CLIP=25
CREDIT_COST_RENDER_PER_MINUTE=6
# Stripe (optional). Without keys, checkout runs in "sandbox" mode and grants plans/credits
# directly so the billing flow can be exercised in development.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_STUDIO=price_...
# STRIPE_PRICE_CREDITS=price_...

# --- Uploads ------------------------------------------------------------------
MAX_DIRECT_UPLOAD_BYTES=209715200      # 200 MiB via the API; larger files use presigned PUT

# --- docker-compose only ------------------------------------------------------
POSTGRES_USER=longform
POSTGRES_PASSWORD=longform
POSTGRES_DB=longform
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
